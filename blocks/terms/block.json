{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fa/terms",
  "title": "Terms",
  "category": "frontenda",
  "icon": "category",
  "parent": ["fa/section"],
  "attributes": {
    "terms": {
      "type": "object",
      "default": {
        "mode": "automatic",
        "taxonomy": "category",
        "termIds": [],
        "perPage": 9,
        "orderBy": "name",
        "order": "asc",
        "hideEmpty": true,
        "nameLike": ""
      }
    }
  },
  "supports": { "html": false, "reusable": false },
  "editorScript": "frontenda-blocks-section-editor"
}
