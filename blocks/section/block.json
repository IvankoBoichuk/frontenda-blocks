{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fa/section",
  "textdomain": "frontenda-blocks",
  "title": "Section",
  "description": "Dynamic content section with subtitle, title, text, optional image, and list items.",
  "category": "frontenda",
  "icon": "layout",
  "keywords": ["section", "content", "benefits"],
  "supports": {
    "html": false,
    "anchor": true,
    "inserter": true
  },
  "providesContext": {
    "fa/variant": "variant",
    "fa/layout": "layout",
    "fa/cardLayouts": "cardLayouts"
  },
  "faConfig": {
    "listItemFields": {
      "default": ["subttl", "ttl", "text", "image", "icon"]
    },
    "variations": {
      "offer": {
        "template": [
          ["fa/header", {}],
          ["fa/text", {}],
          ["fa/buttons", {}],
          ["fa/media", {}]
        ]
      },
      "benefits": {
        "template": [
          ["fa/header", {}],
          ["fa/text", {}],
          ["fa/media", {}],
          ["fa/list", {}]
        ]
      },
      "photogallery": {
        "template": [
          ["fa/media", {}]
        ]
      },
      "numbers": {
        "template": [
          ["fa/header", {}],
          ["fa/numbers", {}]
        ]
      },
      "reviews": {
        "template": [
          ["fa/header", {}],
          ["fa/numbers", {}],
          ["fa/reviews", {}]
        ]
      },
      "faq": {
        "template": [
          ["fa/header", {}],
          ["fa/list", {}]
        ]
      }
    }
  },
  "variations": [
    {
      "name": "offer",
      "title": "Offer",
      "icon": "star-filled",
      "description": "Section for the first block.",
      "attributes": {
        "variant": "offer",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" },
          { "label": "Second", "value": "2" }
        ]
      },
      "isDefault": true,
      "isActive": ["variant"],
      "scope": ["inserter"]
    },
    {
      "name": "benefits",
      "title": "Benefits",
      "icon": "awards",
      "description": "Section with benefits list.",
      "attributes": {
        "variant": "benefits",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" }
        ]
      },
      "isActive": ["variant"],
      "scope": ["inserter"]
    },
    {
      "name": "photogallery",
      "title": "Photogallery",
      "icon": "format-gallery",
      "description": "Section with a media gallery.",
      "attributes": {
        "variant": "photogallery",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" }
        ]
      },
      "isActive": ["variant"],
      "scope": ["inserter"]
    },
    {
      "name": "numbers",
      "title": "Numbers",
      "icon": "chart-bar",
      "description": "Section with heading and a row of stat counters.",
      "attributes": {
        "variant": "numbers",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" }
        ]
      },
      "isActive": ["variant"],
      "scope": ["inserter"]
    },
    {
      "name": "reviews",
      "title": "Reviews",
      "icon": "format-chat",
      "description": "Section with heading, numbers, and approved comments.",
      "attributes": {
        "variant": "reviews",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" }
        ]
      },
      "isActive": ["variant"],
      "scope": ["inserter"]
    },
    {
      "name": "faq",
      "title": "FAQ",
      "icon": "editor-help",
      "description": "Section with heading and FAQ list.",
      "attributes": {
        "variant": "faq",
        "layout": "1",
        "layouts": [
          { "label": "First", "value": "1" }
        ]
      },
      "isActive": ["variant"],
      "scope": ["inserter"]
    }
  ],
  "attributes": {
    "clientId": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "default": ""
    },
    "anchor": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "layouts": {
      "type": "array",
      "default": []
    },
    "cardLayouts": {
      "type": "array",
      "default": [
        { "label": "From template", "value": "" },
        { "label": "Numbered step", "value": "numbered-step" }
      ]
    },
    "meta": {
      "type": "object"
    }
  },
  "editorScript": "frontenda-blocks-section-editor",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
